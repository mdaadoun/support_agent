# 8_support_agent Environment Configuration
SUPPORT_AGENT_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# LLM Inference
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-placeholder
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

# ReAct Agent Guardrails
AGENT_MAX_ITERATIONS=3
CONFIDENCE_THRESHOLD=0.85

# Persistence & Caching
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://support_user:support_pass@localhost:5432/support_agent_db
CACHE_TTL_SECONDS=900

# Mock ERP Store
ERP_DATA_PATH=data/mock_orders.json
